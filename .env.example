# Copy to .env and fill in. Never commit .env.
# Every variable the flow reads is listed here; the required ones are marked.

# --- General ---------------------------------------------------------------
ENV=local
LOG_LEVEL=INFO

# --- Account sizing (required) ---------------------------------------------
# RISK_PER_TRADE is a FRACTION, not a percent. 0.01 means 1% of equity is 1R.
EQUITY=10000
RISK_PER_TRADE=0.01

# --- Local paths (required) ------------------------------------------------
# Per-crew ChromaDB stores. main.py rewrites CREWAI_STORAGE_DIR under this root
# to keep each crew and symbol isolated.
MEMORY_DB_BASE_DIR=./knowledge
CREWAI_STORAGE_DIR=./knowledge
FINAL_REPORT_BASE_DIR=./final_reports

# --- LLM (required) --------------------------------------------------------
# The runtime LLM is always local Ollama. Start it before running the flow.
OLLAMA_BASE_URL=http://localhost:11434
# CrewAI asks for this on import even though nothing calls OpenAI. Any non-empty value works.
OPENAI_API_KEY=NA

# --- Data providers --------------------------------------------------------
FINNHUB_API_KEY=
TAVILY_API_KEY=
TWELVE_API_KEY=
TIMEGPT_API_KEY=
RAPID_API_KEY=

# --- Persistence (optional) ------------------------------------------------
# When set, every run is written to the trading_strategy schema. When unset,
# the flow writes JSON reports only. An unreachable database fails the run
# before any LLM call.
ALGO_TRADING_DATABASE_URL=

# --- Tracing and telemetry -------------------------------------------------
CREWAI_DISABLE_TELEMETRY=true
CREWAI_DISABLE_TRACING=true
CREWAI_TELEMETRY_OPTOUT=true
CREWAI_TELEMETRY=false
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
LANGCHAIN_DEBUG=false

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=swing_trader
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
